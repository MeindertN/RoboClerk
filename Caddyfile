# ==============================================================================
# Caddyfile for RoboClerk Server
# ==============================================================================
#
# This configuration provides:
#   - Automatic HTTPS with Let's Encrypt certificates
#   - HTTP to HTTPS redirect
#   - Reverse proxy to RoboClerk Server
#   - Security headers
#   - Gzip compression
#
# IMPORTANT: Replace 'roboclerk.yourdomain.com' with your actual domain name!
#
# For local development, use Caddyfile.dev instead.
#
# ==============================================================================

# Replace this with your actual domain name
roboclerk.yourdomain.com {
    # Reverse proxy to RoboClerk Server
    reverse_proxy roboclerk-server:8080 {
        # Health check for upstream
        health_uri /health/live
        health_interval 30s
        health_timeout 5s
        
        # Headers to pass to upstream
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        # header_up X-Forwarded-For {remote_host}
        # header_up X-Forwarded-Proto {scheme}
    }
    
    # Enable compression
    encode gzip zstd
    
    # Security headers
    header {
        # HSTS - enforce HTTPS for 1 year
        Strict-Transport-Security "max-age=31536000" # ; includeSubDomains; preload"
        
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        
        # Prevent clickjacking
        X-Frame-Options "DENY"
        
        # XSS protection
        X-XSS-Protection "1; mode=block"
        
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Content Security Policy (adjust as needed for Word Add-in)
        # Content-Security-Policy "default-src 'self'"
        
        # Remove server header
        -Server
    }
    
    # Logging
    log {
        output file /data/logs/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}

# ==============================================================================
# Alternative: Multiple domains or subdomains
# ==============================================================================
# Uncomment and modify to support multiple domains pointing to the same server:
#
# api.yourdomain.com, roboclerk.yourdomain.com {
#     reverse_proxy roboclerk-server:8080
#     encode gzip
# }

# ==============================================================================
# Alternative: With email for Let's Encrypt notifications
# ==============================================================================
# Add this block at the top of the file to receive certificate expiry notifications:
#
# {
#     email your-email@example.com
# }
