# ==============================================================================
# RoboClerk.Server Environment Variables Template
# ==============================================================================
#
# Copy this file to .env and fill in the values.
# The .env file should NEVER be committed to source control!
#
# ==============================================================================

# ASP.NET Core Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# Logging level (Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information

# ==============================================================================
# SharePoint Configuration
# ==============================================================================
# These values must be obtained from your Azure AD app registration
# See: https://docs.microsoft.com/en-us/azure/active-directory/develop/quickstart-register-app

# Application (client) ID from Azure AD app registration
SP_CLIENT_ID=your-client-id-here

# Directory (tenant) ID from Azure AD
SP_TENANT_ID=your-tenant-id-here

# Client secret from Azure AD app registration (required for SharePoint access)
SP_CLIENT_SECRET=your-client-secret-here

# ==============================================================================
# Git Repository Authentication (Optional)
# ==============================================================================
# These tokens are used for cloning private Git repositories when source code
# analysis plugins are configured to use GitSource instead of local directories.
# Only set the tokens for the Git providers you need to access.
# Leave empty or remove lines for providers you don't use.

# GitHub Personal Access Token (classic) or fine-grained token
# Required scopes: repo (for private repos) or public_repo (for public only)
# Create at: https://github.com/settings/tokens
GIT_GITHUB_TOKEN=

# GitLab Personal Access Token
# Required scopes: read_repository
# Create at: https://gitlab.com/-/profile/personal_access_tokens
GIT_GITLAB_TOKEN=

# Azure DevOps Personal Access Token
# Required scopes: Code (Read)
# Create at: https://dev.azure.com/{org}/_usersSettings/tokens
GIT_AZURE_DEVOPS_PAT=

# Bitbucket App Password
# Required permissions: Repositories (Read)
# Create at: https://bitbucket.org/account/settings/app-passwords/
GIT_BITBUCKET_TOKEN=

# Git clone timeout in seconds (default: 300)
GIT_CLONE_TIMEOUT=300

# ==============================================================================
# Optional: RoboClerk specific settings
# ==============================================================================
# ROBOCLERK_LOG_LEVEL=INFO
# ROBOCLERK_CORS_ORIGINS=*

# ==============================================================================
# Optional: Version tag for container image
# ==============================================================================
# VERSION=latest
