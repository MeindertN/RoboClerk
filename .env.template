# ==============================================================================
# RoboClerk.Server Environment Variables Template
# ==============================================================================
#
# Copy this file to .env and fill in the values.
# The .env file should NEVER be committed to source control!
#
# ==============================================================================

# ASP.NET Core Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# Logging level (Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information

# ==============================================================================
# SharePoint Configuration
# ==============================================================================
# These values must be obtained from your Azure AD app registration
# See: https://docs.microsoft.com/en-us/azure/active-directory/develop/quickstart-register-app

# Application (client) ID from Azure AD app registration
SP_CLIENT_ID=your-client-id-here

# Directory (tenant) ID from Azure AD
SP_TENANT_ID=your-tenant-id-here

# Client secret (if using client credentials flow)
# SP_CLIENT_SECRET=your-client-secret-here

# ==============================================================================
# Optional: Version tag for container image
# ==============================================================================
# VERSION=latest
