<?xml version="1.0" encoding="utf-8" ?>
<!-- ==============================================================================
     NLog Configuration for Docker/Container Deployment
     
     This configuration is optimized for containerized environments:
     - Console output uses structured format for log aggregation
     - File output for persistent logs (mounted volume)
     - Reduced noise from Microsoft framework logs
     ============================================================================== -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="/app/logs/nlog-internal.log">

  <!-- Enable ASP.NET Core layout renderers -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <targets>
    <!-- Console output - primary target for Docker logs -->
    <!-- Uses JSON format for easy parsing by log aggregators -->
    <target xsi:type="Console" 
            name="console"
            layout="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}${onexception:inner= ${exception:format=tostring}}" />
    
    <!-- Structured JSON console output (alternative - uncomment to use) -->
    <!--
    <target xsi:type="Console"
            name="jsonConsole">
      <layout xsi:type="JsonLayout" includeAllProperties="true">
        <attribute name="timestamp" layout="${longdate}" />
        <attribute name="level" layout="${level:uppercase=true}" />
        <attribute name="logger" layout="${logger:shortName=true}" />
        <attribute name="message" layout="${message}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
        <attribute name="requestUrl" layout="${aspnet-request-url}" />
        <attribute name="requestMethod" layout="${aspnet-request-method}" />
      </layout>
    </target>
    -->
    
    <!-- File output for persistent logs -->
    <target xsi:type="File" 
            name="file" 
            fileName="/app/logs/roboclerk-server-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true:padding=-5}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
            archiveFileName="/app/logs/archive/roboclerk-server-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />
    
    <!-- Error-only file for critical issues -->
    <target xsi:type="File" 
            name="errorFile" 
            fileName="/app/logs/roboclerk-server-errors-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${newline}${exception:format=tostring}"
            archiveEvery="Day"
            maxArchiveFiles="14" />
  </targets>

  <rules>
    <!-- Skip non-critical Microsoft logs -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />
    
    <!-- Skip noisy System logs -->
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    
    <!-- Log errors to dedicated error file -->
    <logger name="*" minlevel="Error" writeTo="errorFile" />
    
    <!-- All application logs go to console and file -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
