# ==============================================================================
# RoboClerk.Server Dockerfile - Debug Version
# Includes vsdbg for remote debugging from Visual Studio
# ==============================================================================

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["RoboClerk.sln", "./"]
COPY ["RoboClerk/RoboClerk.csproj", "RoboClerk/"]
COPY ["RoboClerk.Core/RoboClerk.Core.csproj", "RoboClerk.Core/"]
COPY ["RoboClerk.Server/RoboClerk.Server.csproj", "RoboClerk.Server/"]
COPY ["RoboClerk.SharePointFileProviderPlugin/RoboClerk.SharePointFileProvider.csproj", "RoboClerk.SharePointFileProviderPlugin/"]
COPY ["RoboClerk.Tests/RoboClerk.Tests.csproj", "RoboClerk.Tests/"]
COPY ["RoboClerk.AzureDevOps/RoboClerk.AzureDevOps.csproj", "RoboClerk.AzureDevOps/"]
COPY ["RoboClerk.Redmine/RoboClerk.Redmine.csproj", "RoboClerk.Redmine/"]
COPY ["RoboClerk.OpenAI/RoboClerk.OpenAI.csproj", "RoboClerk.OpenAI/"]
COPY ["RoboClerk.AnnotatedUnitTests/RoboClerk.AnnotatedUnitTests.csproj", "RoboClerk.AnnotatedUnitTests/"]
COPY ["RoboClerk.UnitTestFN/RoboClerk.UnitTestFN.csproj", "RoboClerk.UnitTestFN/"]
COPY ["RoboClerk.DependenciesFile/RoboClerk.DependenciesFile.csproj", "RoboClerk.DependenciesFile/"]
COPY ["RoboClerk.TestDescriptionImportPlugin/RoboClerk.TestDescriptionFilePlugin.csproj", "RoboClerk.TestDescriptionImportPlugin/"]
COPY ["RoboClerk.TestResultsFilePlugin/RoboClerk.TestResultsFilePlugin.csproj", "RoboClerk.TestResultsFilePlugin/"]

RUN dotnet restore "RoboClerk.sln"

COPY . .

# Build in Debug configuration for debugging symbols
WORKDIR "/src/RoboClerk.Server"
RUN dotnet publish -c Debug -o /app/publish --no-restore

# Publish all plugins to /app/plugins (flat directory - required by PluginLoader)
WORKDIR "/src/RoboClerk.SharePointFileProviderPlugin"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

WORKDIR "/src/RoboClerk.Redmine"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

WORKDIR "/src/RoboClerk.AzureDevOps"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

WORKDIR "/src/RoboClerk.OpenAI"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

WORKDIR "/src/RoboClerk.AnnotatedUnitTests"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

WORKDIR "/src/RoboClerk.UnitTestFN"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

WORKDIR "/src/RoboClerk.DependenciesFile"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

WORKDIR "/src/RoboClerk.TestDescriptionImportPlugin"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

WORKDIR "/src/RoboClerk.TestResultsFilePlugin"
RUN dotnet publish -c Debug -o /app/plugins --no-restore

# ==============================================================================
# Runtime stage - using full SDK for debugging (not Alpine)
# ==============================================================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS runtime

# Install vsdbg (Visual Studio Debugger)
RUN apt-get update && apt-get install -y unzip curl procps \
    && curl -sSL https://aka.ms/getvsdbgsh | /bin/sh /dev/stdin -v latest -l /vsdbg \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Development

# Copy published output
COPY --from=build /app/publish .
COPY --from=build /app/plugins ./plugins/

# Create directories
RUN mkdir -p /app/logs /app/logs/archive /app/config /app/RoboClerk_input/RoboClerkConfig /app/RoboClerk_input/PluginConfig

# Copy configurations
COPY --from=build /src/RoboClerk.Server/Configuration/RoboClerk.Docker.toml /app/RoboClerk_input/RoboClerkConfig/RoboClerk.toml
COPY --from=build /src/RoboClerk.Server/Configuration/RoboClerk.Server.Docker.toml /app/RoboClerk.Server.toml
COPY --from=build /src/RoboClerk.Server/nlog.docker.config /app/nlog.config

# Copy plugin configurations
COPY --from=build /src/RoboClerk.SharePointFileProviderPlugin/Configuration/SharePointFileProviderPlugin.toml /app/RoboClerk_input/PluginConfig/
COPY --from=build /src/RoboClerk.Redmine/Configuration/RedmineSLMSPlugin.toml /app/RoboClerk_input/PluginConfig/
COPY --from=build /src/RoboClerk.AzureDevOps/Configuration/AzureDevOpsSLMSPlugin.toml /app/RoboClerk_input/PluginConfig/
COPY --from=build /src/RoboClerk.OpenAI/Configuration/OpenAIPlugin.toml /app/RoboClerk_input/PluginConfig/
COPY --from=build /src/RoboClerk.AnnotatedUnitTests/Configuration/AnnotatedUnitTestPlugin.toml /app/RoboClerk_input/PluginConfig/
COPY --from=build /src/RoboClerk.DependenciesFile/Configuration/DependenciesFilePlugin.toml /app/RoboClerk_input/PluginConfig/
COPY --from=build /src/RoboClerk.TestDescriptionImportPlugin/Configuration/TestDescriptionFilePlugin.toml /app/RoboClerk_input/PluginConfig/
COPY --from=build /src/RoboClerk.TestResultsFilePlugin/Configuration/TestResultsFilePlugin.toml /app/RoboClerk_input/PluginConfig/
COPY --from=build /src/RoboClerk.UnitTestFN/Configuration/UnitTestFNPlugin.toml /app/RoboClerk_input/PluginConfig/

EXPOSE 8080

ENTRYPOINT ["dotnet", "RoboClerk.Server.dll"]
